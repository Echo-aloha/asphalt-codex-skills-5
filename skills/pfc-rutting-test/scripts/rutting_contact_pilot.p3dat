; Independently authored PFC3D 5.0 curved-wheel contact and translation pilot.
; It is not a normative wheel-tracking specimen or dynamic-stability result.
; runtime_validated: true (manual smoke record; see docs/pfc5-runtime-verification.md)
new
title 'PFC5 rutting curved-wheel contact pilot'
domain extent -0.05 0.05 -0.04 0.04 -0.03 0.05 condition destroy
cmat default model linear property kn 5.0e7 ks 2.0e7 fric 0.45 dp_nratio 0.2

ball create id 1 radius 0.005 position (-0.015,0.0,0.0)
ball create id 2 radius 0.005 position (-0.005,0.0,0.0)
ball create id 3 radius 0.005 position ( 0.005,0.0,0.0)
ball create id 4 radius 0.005 position ( 0.015,0.0,0.0)
ball attribute density 2500.0
ball fix x y z spin

wall generate id 1 cylinder base (-0.015,-0.015,0.014) axis (0,1,0) height 0.03 radius 0.010 cap false false onewall
clean
[pilot_wheel = wall.find(1)]
define wheel_vertical_force
    wheel_vertical_force = wall.force.contact(pilot_wheel,3)
end
define wheel_travel
    wheel_travel = wall.disp(pilot_wheel,1)
end
define wheel_sink
    wheel_sink = -wall.disp(pilot_wheel,3)
end

history id 1 @wheel_vertical_force
history id 2 @wheel_travel
history id 3 @wheel_sink
history nstep 20
wall attribute zvelocity -5.0e-2 range id 1
cycle 800
wall attribute zvelocity 0.0 range id 1
wall attribute xvelocity 5.0e-1 range id 1
cycle 2400
wall attribute xvelocity 0.0 range id 1
save 'rutting_contact_pilot'
return
